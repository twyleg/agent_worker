#!/usr/bin/env bash
set -euo pipefail

# Hot-plug exactly one host project into the running Agent VM via virtiofs.
# The helper also mounts/unmounts the filesystem inside the guest over the
# dedicated SSH key created by agent_vm_create.
#
# Usage:
#   agent_vm_mount_project attach /path/to/project
#   agent_vm_mount_project status
#   agent_vm_mount_project detach

# Keep runtime data at the project root, even when invoked from another directory.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
DATA_DIR="$(realpath -m -- "${DATA_DIR:-$PROJECT_DIR/.data}")"

VM_NAME="${VM_NAME:-agent-xubuntu}"
AGENT_USER="${AGENT_USER:-${CODEX_USER:-agent}}"
WORKSPACE_HELPER_PREFIX="${WORKSPACE_HELPER_PREFIX:-agent-workspace}"
LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"
TAG="${AGENT_SHARE_TAG:-${CODEX_SHARE_TAG:-agent-project}}"
EXPORT_DIR="${AGENT_EXPORT_DIR:-${CODEX_EXPORT_DIR:-$DATA_DIR/share/current}}"
STATE_DIR="${STATE_DIR:-$DATA_DIR/state}"
STATE_XML="$STATE_DIR/current-share.xml"
STATE_PATH="$STATE_DIR/current-share.path"
SSH_KEY="$STATE_DIR/id_ed25519"
KNOWN_HOSTS="$STATE_DIR/known_hosts"

log() { printf '==> %s\n' "$*"; }
die() { echo "ERROR: $*" >&2; exit 1; }

mkdir -p "$STATE_DIR"

vm_running() {
  sudo virsh -c "$LIBVIRT_URI" domstate "$VM_NAME" 2>/dev/null | grep -qi '^running$'
}

export_is_mounted() {
  findmnt -rn -M "$EXPORT_DIR" >/dev/null 2>&1
}

vm_mac() {
  sudo virsh -c "$LIBVIRT_URI" domiflist "$VM_NAME" \
    | awk '$2 == "network" {print $5; exit}'
}

vm_ip() {
  local ip mac
  ip="$(sudo virsh -c "$LIBVIRT_URI" domifaddr "$VM_NAME" --source agent 2>/dev/null \
        | awk '$3 == "ipv4" {sub(/\/.*/, "", $4); if ($4 !~ /^(127\.|0\.|169\.254\.)/) {print $4; exit}}')"
  if [[ -n "$ip" ]]; then
    printf '%s\n' "$ip"
    return 0
  fi
  mac="$(vm_mac)"
  ip="$(sudo virsh -c "$LIBVIRT_URI" net-dhcp-leases default 2>/dev/null \
        | awk -v m="$mac" 'tolower($3)==tolower(m) {sub(/\/.*/, "", $5); print $5; exit}')"
  [[ -n "$ip" ]] && printf '%s\n' "$ip"
}

guest_ssh() {
  local ip
  [[ -f "$SSH_KEY" ]] || return 1
  ip="$(vm_ip || true)"
  [[ -n "$ip" ]] || return 1
  ssh -i "$SSH_KEY" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o ConnectTimeout=5 \
    -o StrictHostKeyChecking=accept-new \
    -o "UserKnownHostsFile=$KNOWN_HOSTS" \
    "${AGENT_USER}@${ip}" "$@"
}

project_mountpoint() {
  local project_name
  project_name="$(basename -- "$1")"
  [[ "$project_name" != / && "$project_name" != . && "$project_name" != .. ]] || die "Invalid project directory name."
  printf '/home/%s/workspace/%s\n' "$AGENT_USER" "$project_name"
}

# Run the mount operations directly so already-created guests do not need their
# older workspace helper scripts replaced before using project subdirectories.
mount_guest_project() {
  local command
  printf -v command 'sudo bash -s -- %q %q %q' "$1" "$TAG" "/home/$AGENT_USER/workspace"
  guest_ssh "$command" <<'GUEST'
set -euo pipefail
mountpoint=$1
tag=$2
workspace=$3
if findmnt -rn -M "$workspace" -t virtiofs >/dev/null; then
  echo "A legacy share is mounted at $workspace; detach it first." >&2
  exit 1
fi
mkdir -p "$mountpoint"
if findmnt -rn -M "$mountpoint" -t virtiofs >/dev/null; then
  echo "Already mounted: $mountpoint"
else
  mount -t virtiofs "$tag" "$mountpoint"
  echo "Mounted $tag at $mountpoint"
fi
GUEST
}

unmount_guest_project() {
  local command
  printf -v command 'sudo bash -s -- %q %q' "$1" "/home/$AGENT_USER/workspace"
  guest_ssh "$command" <<'GUEST'
set -euo pipefail
# The second path supports detaching shares made with the old flat layout.
for mountpoint in "$1" "$2"; do
  if findmnt -rn -M "$mountpoint" -t virtiofs >/dev/null; then
    umount "$mountpoint"
    echo "Unmounted $mountpoint"
  fi
done
GUEST
}

write_xml() {
  cat >"$STATE_XML" <<EOF2
<filesystem type='mount' accessmode='passthrough'>
  <driver type='virtiofs' queue='1024'/>
  <source dir='$EXPORT_DIR'/>
  <target dir='$TAG'/>
</filesystem>
EOF2
}

case "${1:-}" in
  attach)
    [[ $# -eq 2 ]] || die "Usage: $0 attach PROJECT_PATH"
    vm_running || die "VM '$VM_NAME' is not running."
    [[ ! -f "$STATE_XML" ]] || die "A project is already attached. Detach it first: $0 detach"

    project="$(realpath -e "$2")"
    [[ -d "$project" ]] || die "Not a directory: $project"
    guest_path="$(project_mountpoint "$project")"

    sudo install -d -m 0755 "$EXPORT_DIR"
    export_is_mounted && die "$EXPORT_DIR is already a mount point. Clean it up before attaching another project."

    log "Staging only this project: $project"
    sudo mount --bind "$project" "$EXPORT_DIR"

    write_xml
    printf '%s\n' "$project" >"$STATE_PATH"

    log "Hot-attaching project to '$VM_NAME'"
    if ! sudo virsh -c "$LIBVIRT_URI" attach-device "$VM_NAME" "$STATE_XML" --live; then
      sudo umount "$EXPORT_DIR" || true
      rm -f "$STATE_XML" "$STATE_PATH"
      die "virtiofs hot-attach failed."
    fi

    log "Mounting project inside the guest"
    if mount_guest_project "$guest_path"; then
      echo "Ready: $project -> $guest_path"
    else
      printf -v manual_mount 'sudo mkdir -p %q && sudo mount -t virtiofs %q %q' "$guest_path" "$TAG" "$guest_path"
      cat <<EOF2
The virtiofs device is attached, but automatic guest mounting failed.
Inside the VM run:
  $manual_mount

The project will then be available at:
  $guest_path
EOF2
    fi
    ;;

  detach)
    vm_running || die "VM '$VM_NAME' is not running."
    [[ -f "$STATE_XML" ]] || die "No tracked project share is attached."

    log "Unmounting project inside the guest"
    guest_path="$(project_mountpoint "$(cat "$STATE_PATH")")"
    if ! unmount_guest_project "$guest_path"; then
      die "Could not unmount the project inside the guest. Ensure it is not in use, then retry."
    fi

    log "Hot-detaching $(cat "$STATE_PATH" 2>/dev/null || echo project)"
    sudo virsh -c "$LIBVIRT_URI" detach-device "$VM_NAME" "$STATE_XML" --live

    export_is_mounted && sudo umount "$EXPORT_DIR"
    rm -f "$STATE_XML" "$STATE_PATH"
    log "Detached; no host project is exposed to the VM"
    ;;

  status)
    if [[ -f "$STATE_PATH" ]]; then
      guest_path="$(project_mountpoint "$(cat "$STATE_PATH")")"
      echo "Host project:  $(cat "$STATE_PATH")"
      echo "Staging dir:   $EXPORT_DIR"
      echo "Guest path:    $guest_path"
      export_is_mounted && findmnt "$EXPORT_DIR"
      printf -v status_command "findmnt -rn -M %q -t virtiofs >/dev/null && echo 'Guest mount:   mounted' || echo 'Guest mount:   not mounted'" "$guest_path"
      if guest_ssh "$status_command" 2>/dev/null; then
        :
      fi
    else
      echo "No project is currently attached."
    fi
    ;;

  *)
    echo "Usage: $0 {attach PROJECT_PATH|detach|status}" >&2
    exit 2
    ;;
esac
