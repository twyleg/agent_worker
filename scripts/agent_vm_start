#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/agent_vm_common"
[[ $# -eq 0 ]] || die "Usage: agent_vm_start"

state="$(vm_virsh domstate "$VM_NAME")"
if [[ "$state" == running ]]; then
  echo "VM '$VM_NAME' is already running."
  exit 0
fi
vm_virsh start "$VM_NAME"
echo 'VM started. Once SSH is ready, connect with: agent_vm_connect'
