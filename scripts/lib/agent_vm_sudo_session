# Keep the calling user's sudo timestamp valid during long installation steps.
# Source from a Bash script and call start_sudo_session before privileged work.
SUDO_REFRESH_PID=""

start_sudo_session() {
  # This is the only call allowed to ask for a password.
  command sudo -v || return
  (
    trap - ERR
    refresh_sleep_pid=""
    trap 'if [[ -n "$refresh_sleep_pid" ]]; then kill "$refresh_sleep_pid" 2>/dev/null || true; wait "$refresh_sleep_pid" 2>/dev/null || true; fi; exit 0' TERM INT
    while true; do
      sleep 30 &
      refresh_sleep_pid=$!
      wait "$refresh_sleep_pid" || exit
      refresh_sleep_pid=""
      if ! command sudo -n -v; then
        echo 'ERROR: Sudo authorization could not be refreshed. Later privileged operations will fail without prompting.' >&2
        exit 1
      fi
    done
  ) &
  SUDO_REFRESH_PID=$!
}

stop_sudo_session() {
  if [[ -n "$SUDO_REFRESH_PID" ]]; then
    kill "$SUDO_REFRESH_PID" 2>/dev/null || true
    wait "$SUDO_REFRESH_PID" 2>/dev/null || true
    SUDO_REFRESH_PID=""
  fi
}

# After initial validation, a privileged operation must never block on a prompt.
sudo() { command sudo -n "$@"; }
