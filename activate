# Source this file in Bash: source /path/to/agent_worker_vm/activate
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  echo 'Source this file to activate the VM commands: source ./activate' >&2
  exit 1
fi

_agent_vm_activate() {
  local scripts_dir
  scripts_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/scripts" && pwd -P)" || return
  case ":${PATH:-}:" in
    *":$scripts_dir:"*) ;;
    *) export PATH="$scripts_dir${PATH:+:$PATH}" ;;
  esac
}
_agent_vm_activate
unset -f _agent_vm_activate
